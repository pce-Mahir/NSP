# Copy to .env and fill in values. Never commit .env.

# Google Gemini — required for resume parsing and career guidance
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional: persist analysis history and enable real auth
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
